# Copiez ce fichier en .env.local (jamais versionné) ou renseignez ces
# variables dans Vercel → Settings → Environment Variables.

# Clé secrète Stripe (sk_test_… en test, sk_live_… en production)
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Identifiants des tarifs Stripe
STRIPE_PRICE_ID_UNIT=    # 1,90 € — paiement unique
STRIPE_PRICE_ID_DAY=     # 2,90 € — paiement unique
STRIPE_PRICE_ID_MONTH=   # 4,90 €/mois — abonnement

# Clé API Claude (génération des courriers)
ANTHROPIC_API_KEY=

# Optionnel — URL publique du site, sécurise les retours après paiement
PUBLIC_BASE_URL=

# Optionnel — secret dédié à la signature des jetons d'accès
LETTREO_TOKEN_SECRET=
